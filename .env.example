# =============================================================================
# Variáveis de Ambiente – Tech Challenge Fase 2
# Copie este arquivo para .env e preencha com seus valores reais.
# NUNCA commite o .env com valores reais!
# =============================================================================

# --- LLM via Ollama (local) ---
# URL do servidor Ollama (padrão ao rodar `ollama serve`)
OLLAMA_BASE_URL=http://localhost:11434

# Modelo a ser utilizado (deve estar disponível via `ollama pull <modelo>`)
OLLAMA_MODEL=qwen3:8b

# Temperatura do modelo (0.0 = determinístico, 1.0 = criativo)
LLM_TEMPERATURE=0.3

# Timeout para chamadas à LLM (segundos)
LLM_TIMEOUT=60

# Ativar modo mock da LLM (true = não chama o Ollama; útil para testes)
LLM_MOCK=false

# --- Algoritmo Genético ---
# Seed para reprodutibilidade dos experimentos
GA_SEED=42

# --- Logging ---
# Nível de log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Caminho para arquivo de log (deixe vazio para log apenas no console)
LOG_FILE=

# --- Ambiente ---
# Ambiente de execução: development, testing, production
ENV=development
