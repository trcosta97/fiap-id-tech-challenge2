# =============================================================================
# Variáveis de Ambiente – Tech Challenge Fase 2
# Copie este arquivo para .env e preencha com seus valores reais.
# NUNCA commite o .env com valores reais!
# =============================================================================

# --- LLM / API ---
# Chave da API OpenAI (ou outro provider escolhido)
OPENAI_API_KEY=sua_chave_aqui

# Modelo a ser utilizado (ex: gpt-4o, gpt-3.5-turbo, gpt-4-turbo)
LLM_MODEL=gpt-4o

# Temperatura do modelo (0.0 = determinístico, 1.0 = criativo)
LLM_TEMPERATURE=0.3

# Timeout para chamadas à LLM (segundos)
LLM_TIMEOUT=30

# --- Algoritmo Genético ---
# Seed para reprodutibilidade dos experimentos
GA_SEED=42

# --- Logging ---
# Nível de log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Caminho para arquivo de log (deixe vazio para log apenas no console)
LOG_FILE=

# --- Ambiente ---
# Ambiente de execução: development, testing, production
ENV=development
